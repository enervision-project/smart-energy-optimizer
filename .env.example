# Copy to .env (never committed), then fill in the values.
#   cp .env.example .env

POSTGRES_USER=enervision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enervision

# Application accounts, created by db-bootstrap. One secret per account: openssl rand -hex 24
CORE_API_DB_PASSWORD=
ETL_DB_PASSWORD=
PREDICTION_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
MONITORING_DB_PASSWORD=
ETL_DATABASE_URL=postgresql://etl_worker:REPLACE_ETL_PASSWORD@db:5432/enervision
PREDICTION_DATABASE_URL=postgresql://prediction_jobs:REPLACE_PREDICTION_PASSWORD@db:5432/enervision

# JWT signing key (Base64, 32 bytes min): openssl rand -base64 32
JWT_SECRET=

# Token lifetime (Spring format: 30m, 1h, 1d)
JWT_EXPIRATION=1h

# First ADMIN account, created while the users table is empty. Empty email: none. Password: 12 characters min.
ADMIN_EMAIL=admin@enervision.local
ADMIN_PASSWORD=

# Database connection when the API runs on the host (exposed port 15432).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/enervision
SPRING_DATASOURCE_USERNAME=core_api
SPRING_DATASOURCE_PASSWORD=

# Inside Compose; on the host use localhost:15432.

# host.docker.internal = the host machine, if the API runs locally.
ENERGY_API_BASE_URL=http://10.43.43.80:8000
# HTTP Basic credentials, empty if the API requires none.
ENERGY_API_USERNAME=
ENERGY_API_PASSWORD=

# Raw data S3 bucket. Empty locally: no archiving.
BRONZE_BUCKET=

# ETL schedule (crontab syntax, UTC).
ETL_CRON=*/5 * * * *

# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Local MLflow (Compose ml profile)
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow-local
MLFLOW_PORT=5000
# Local historical snapshot for prediction-jobs; Terraform provides the S3 URI in production.
TRAINING_BOOTSTRAP_URI=/bootstrap
REGISTERED_MODEL_NAME=enervision-hourly-consumption
TRAINING_TIMEZONE=Europe/Paris
# Changing the password does not update an existing PostgreSQL role.
