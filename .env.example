# Modèle de configuration : copier en .env (jamais versionné) puis renseigner les valeurs.
#   cp .env.example .env

# --- Base de données (conteneur db : PostgreSQL 16 + TimescaleDB)
POSTGRES_USER=enervision
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enervision

# Comptes applicatifs distincts du superutilisateur ci-dessus.
# Générer un secret par compte : openssl rand -hex 24 (également sûr dans une URL).
# db-bootstrap crée les comptes et applique les mots de passe à chaque exécution.
CORE_API_DB_PASSWORD=
ETL_DB_PASSWORD=
PREDICTION_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
MONITORING_DB_PASSWORD=
ETL_DATABASE_URL=postgresql://etl_worker:REPLACE_ETL_PASSWORD@db:5432/enervision
PREDICTION_DATABASE_URL=postgresql://prediction_jobs:REPLACE_PREDICTION_PASSWORD@db:5432/enervision

# --- core-api
# Clé de signature des jetons JWT (HMAC-SHA256, Base64, 32 octets minimum).
# Générer une clé propre à chaque environnement : openssl rand -base64 32
JWT_SECRET=

# Durée de validité des jetons (format Spring : 30m, 1h, 1d…)
JWT_EXPIRATION=1h

# Premier compte ADMIN, créé au démarrage de l'API tant que la table users est vide.
# Laisser ADMIN_EMAIL vide pour ne rien créer. Mot de passe : 12 caractères minimum.
ADMIN_EMAIL=admin@enervision.local
ADMIN_PASSWORD=

# Connexion à la base quand l'API est lancée sur l'hôte (java -jar, IDE) : port exposé 15432.
# Utilise le compte core_api et CORE_API_DB_PASSWORD. Compose utilise l'hôte « db ».
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/enervision
SPRING_DATASOURCE_USERNAME=core_api
SPRING_DATASOURCE_PASSWORD=

# --- etl-worker
# Connexion à la base depuis le conteneur (hôte « db » = nom du service dans compose.yaml).
# Pour une exécution hors Compose, exporter DATABASE_URL avec ETL_DATABASE_URL
# (ou remplacer db:5432 par localhost:15432 pour une exécution sur l'hôte).

# URL de l'API énergie (API Mock de l'école).
# host.docker.internal = la machine hôte, si l'API tourne en local.
ENERGY_API_BASE_URL=http://10.43.43.80:8000
# Identifiants HTTP Basic de l'API (fournis par le formateur) ; vides si l'API n'en demande pas.
ENERGY_API_USERNAME=
ENERGY_API_PASSWORD=

# Bucket S3 des données brutes (bronze/readings/minutes/...). Vide en local : pas d'archivage.
# En production, renseigné par Terraform ; identifiants = rôle de l'instance EC2.
BRONZE_BUCKET=

# Planification de l'ETL (syntaxe crontab, UTC) : ici toutes les 5 minutes.
ETL_CRON=*/5 * * * *

# Niveau de log : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- MLflow local (profil Compose ml, demarrage explicite du service mlflow)
# Base et utilisateur dedies dans le PostgreSQL existant.
# Valeurs optionnelles : les memes defauts sont definis dans Compose.
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow-local
MLFLOW_PORT=5000
# Snapshot historique local pour prediction-jobs ; en production l'URI S3 vient de Terraform.
TRAINING_BOOTSTRAP_URI=/bootstrap
REGISTERED_MODEL_NAME=enervision-hourly-consumption
TRAINING_TIMEZONE=Europe/Paris
VALIDATION_DAYS=14
MIN_CURRENT_VALIDATION_HOURS=168
# Une modification du mot de passe ne change pas le role PostgreSQL deja cree.
