{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": { "schedule": ["at any time"] },
  "node": {
    "supportPolicy": ["lts"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.enervision:**"],
      "enabled": false
    },
    {
      "groupName": "npm (non-major)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "angular (major)",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**",
        "@schematics/angular",
        "angular-eslint",
        "@angular-eslint/**",
        "ng-packagr"
      ],
      "matchUpdateTypes": ["major"]
    },
    {
      "groupName": "angular (non-major)",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@angular/**",
        "@angular-devkit/**",
        "@schematics/angular",
        "angular-eslint",
        "@angular-eslint/**",
        "ng-packagr"
      ],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "groupName": "npm (non-major)",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "maven (non-major)",
      "matchManagers": ["maven", "maven-wrapper"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "groupName": "Docker (non-major)",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "CI",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "matchManagers": ["terraform"],
      "groupName": "Terraform (non-major)",
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Limiter les runners GitHub Ubuntu aux versions LTS supportees (bloque 26.04 tant qu'elle n'est pas disponible et exclut les versions intermédiaires non-LTS)",
      "matchDatasources": ["github-runners"],
      "matchPackageNames": ["ubuntu"],
      "allowedVersions": "<= 24.04"
    },
    {
      "description": "Limiter l'image Docker de Node.js aux versions majeures LTS (paires)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node", "docker.io/library/node"],
      "allowedVersions": "/^(?:18|20|22|24|26)(?:\\.|-|$)/"
    }
  ]
}