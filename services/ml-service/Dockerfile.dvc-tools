FROM docker.io/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DVC_NO_ANALYTICS=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-dvc.txt /tmp/requirements-dvc.txt
RUN pip install --no-cache-dir -r /tmp/requirements-dvc.txt

ARG DVC_UID=10001
ARG DVC_GID=10001
RUN groupadd --non-unique --gid "$DVC_GID" dvc \
    && useradd --non-unique --create-home --uid "$DVC_UID" --gid "$DVC_GID" dvc

WORKDIR /workspace
USER dvc
ENTRYPOINT ["dvc"]
