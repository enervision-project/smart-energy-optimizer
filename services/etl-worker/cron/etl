SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# Container timezone: Europe/Paris.
# Run as root: only root can write to /proc/1/fd/1 and 2; job.sh then runs the command as appuser.
* * * * * root /usr/local/bin/etl-cron-job sync-readings >> /proc/1/fd/1 2>> /proc/1/fd/2
* * * * * root /usr/local/bin/etl-cron-job sync-alerts >> /proc/1/fd/1 2>> /proc/1/fd/2
0 16 * * * root /usr/local/bin/etl-cron-job sync-sites >> /proc/1/fd/1 2>> /proc/1/fd/2
# After sync-sites: a new site gets its profile the same day.
1 16 * * * root /usr/local/bin/etl-cron-job sync-site-profiles >> /proc/1/fd/1 2>> /proc/1/fd/2
# Backfills minutes never received over the last 6 hours.
1 * * * * root /usr/local/bin/etl-cron-job backfill-readings >> /proc/1/fd/1 2>> /proc/1/fd/2
# After the backfill: recomputes the last 6 hours with the filled minutes.
2 * * * * root /usr/local/bin/etl-cron-job sync-hours >> /proc/1/fd/1 2>> /proc/1/fd/2
