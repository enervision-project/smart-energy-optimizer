SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# Fuseau du conteneur : Europe/Paris (heure d'été/hiver).
* * * * * appuser /usr/local/bin/etl-cron-job sync-readings >> /proc/1/fd/1 2>> /proc/1/fd/2
* * * * * appuser /usr/local/bin/etl-cron-job sync-alerts >> /proc/1/fd/1 2>> /proc/1/fd/2
0 16 * * * appuser /usr/local/bin/etl-cron-job sync-sites >> /proc/1/fd/1 2>> /proc/1/fd/2
# Après sync-sites : un nouveau site reçoit son profil le jour même.
1 16 * * * appuser /usr/local/bin/etl-cron-job sync-site-profiles >> /proc/1/fd/1 2>> /proc/1/fd/2
# Rattrapage via /readings des minutes jamais reçues sur les 6 dernières heures.
1 * * * * appuser /usr/local/bin/etl-cron-job backfill-readings >> /proc/1/fd/1 2>> /proc/1/fd/2
# Après le rattrapage : recalcule les 6 dernières heures pour intégrer les minutes comblées.
2 * * * * appuser /usr/local/bin/etl-cron-job sync-hours >> /proc/1/fd/1 2>> /proc/1/fd/2
