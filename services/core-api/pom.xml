<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- Spring Boot parent: already manages the versions of the starters, Lombok, PostgreSQL, etc. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<!-- Parent project -->
	<groupId>com.enervision</groupId>
	<artifactId>core-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>core-api</name>
	<description>Enervision Core API - Modular Monolith</description>

	<!-- Maven modules -->
	<modules>
		<module>common</module>
		<module>configuration</module>
		<module>user</module>
		<module>diagnostic</module>
		<module>telemetry</module>
		<module>bootstrap</module>
	</modules>

	<!-- Properties -->
	<properties>
		<java.version>21</java.version>
		<springdoc.version>3.1.1</springdoc.version>

		<!-- Build plugins not managed by Spring Boot -->
		<jacoco.version>0.8.15</jacoco.version>
		<spotless.version>3.10.4</spotless.version>
		<sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

		<!-- SonarCloud analysis (./mvnw verify sonar:sonar, token in SONAR_TOKEN).
		     Coverage: each module's target/site/jacoco/jacoco.xml, Sonar's default path -->
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		<sonar.organization>enervision-project</sonar.organization>
		<sonar.projectKey>enervision-project_smart-energy-optimizer_core_api</sonar.projectKey>
		<!-- Code without logic to test: keep in sync with the JaCoCo excludes below -->
		<sonar.coverage.exclusions>**/Application.java,**/config/**,**/*Config.java,**/*Properties.java,**/dto/**,**/entity/**,**/exception/**</sonar.coverage.exclusions>
	</properties>

	<!-- Centralized dependency management.
	     Do NOT redeclare Spring Boot starters here without a version:
	     it overrides the parent's management and causes "version is missing". -->
	<dependencyManagement>
		<dependencies>

			<!-- Internal modules -->
			<dependency>
				<groupId>com.enervision</groupId>
				<artifactId>common</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.enervision</groupId>
				<artifactId>configuration</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.enervision</groupId>
				<artifactId>user</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.enervision</groupId>
				<artifactId>diagnostic</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.enervision</groupId>
				<artifactId>telemetry</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Springdoc OpenAPI (not managed by Spring Boot) -->
			<dependency>
				<groupId>org.springdoc</groupId>
				<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
				<version>${springdoc.version}</version>
			</dependency>

		</dependencies>
	</dependencyManagement>

	<!-- Shared build configuration -->
	<build>
		<pluginManagement>
			<plugins>

				<!-- Java compilation and Lombok annotation processing (inherited by all modules) -->
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>

				<!-- SonarCloud analysis, run on demand (sonar:sonar) -->
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>${sonar-maven-plugin.version}</version>
				</plugin>

			</plugins>
		</pluginManagement>

		<!-- Quality checks run by verify in every module (and in CI) -->
		<plugins>

			<!-- Integration tests (*IT, e.g. Testcontainers): executions configured by the Spring Boot parent.
			     Unit tests (*Test) stay with surefire. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>

			<!-- Coverage: agent for unit and integration tests, then report read by Sonar
			     (minimum coverage enforced by the Sonar quality gate, not by the build) -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<!-- Code without logic to test: keep in sync with sonar.coverage.exclusions -->
					<excludes>
						<exclude>**/Application.class</exclude>
						<exclude>**/config/**</exclude>
						<exclude>**/*Config.class</exclude>
						<exclude>**/*Properties.class</exclude>
						<exclude>**/dto/**</exclude>
						<exclude>**/entity/**</exclude>
						<exclude>**/exception/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Formatting: Eclipse formatter (tabs). spotless:check fails verify, ./mvnw spotless:apply fixes it -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless.version}</version>
				<configuration>
					<java>
						<eclipse>
							<file>${maven.multiModuleProjectDirectory}/eclipse-formatter.xml</file>
						</eclipse>
						<removeUnusedImports/>
						<trimTrailingWhitespace/>
						<endWithNewline/>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

		</plugins>
	</build>

</project>
