{
  "global": [
    "compose.yaml",
    "compose.prod.yaml",
    "infra/deploy/",
    ".github/services.json",
    ".github/workflows/services.yml",
    "scripts/ci/"
  ],
  "services": {
    "proxy": {
      "paths": ["infra/proxy/"]
    },
    "web": {
      "paths": ["app/web/"],
      "build": { "context": "app/web", "dockerfile": "app/web/Dockerfile" }
    },
    "core-api": {
      "paths": ["services/core-api/"],
      "build": { "context": ".", "dockerfile": "services/core-api/Dockerfile" }
    },
    "etl-worker": {
      "paths": ["services/etl-worker/"],
      "build": { "context": ".", "dockerfile": "services/etl-worker/Dockerfile" }
    },
    "prediction-service": {
      "paths": [
        "services/prediction-service/",
        "services/ml-service/training/",
        "services/ml-service/configs/hgb_production.yaml"
      ],
      "build": { "context": ".", "dockerfile": "services/prediction-service/Dockerfile" }
    },
    "db": {
      "paths": ["infra/db/"]
    },
    "mlflow": {
      "paths": ["services/ml-service/mlflow/"],
      "build": {
        "context": "services/ml-service/mlflow",
        "dockerfile": "services/ml-service/mlflow/Dockerfile"
      }
    },
    "monitoring": {
      "paths": ["infra/monitoring/"]
    },
    "alloy": {
      "paths": ["infra/alloy/"]
    }
  }
}
