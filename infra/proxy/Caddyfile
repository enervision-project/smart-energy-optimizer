# Production reverse proxy; Caddy obtains and renews the Let's Encrypt certificates.

# HTTP metrics (requests, status codes, latency), labelled by host
{
	metrics {
		per_host
	}
}

{$DOMAIN} {
	encode zstd gzip

	# JSON access logs on stdout, collected by Alloy (Authorization and cookies are redacted by Caddy)
	log {
		output stdout
		format json
	}

	# API (core-api), same domain as the front end: no CORS
	handle /api/* {
		reverse_proxy core-api:8080
	}

	# everything else: Angular front end
	handle {
		reverse_proxy web:8080
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Prometheus endpoint scraped by Alloy: Docker network only (port not published in compose)
:9180 {
	metrics
}
