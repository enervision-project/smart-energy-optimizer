# Reverse proxy de production (service proxy de compose.prod.yaml).
# Certificats Let's Encrypt obtenus et renouvelés automatiquement par Caddy.
{$DOMAIN} {
	encode zstd gzip

	# API (core-api), même domaine que le front : pas de CORS
	handle /api/* {
		reverse_proxy core-api:8080
	}

	# tout le reste : front Angular
	handle {
		reverse_proxy web:80
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
